FROM nvcr.io/nvidia/pytorch:26.04-py3

ENV PIP_NO_CACHE_DIR=1 \
    PYTHONUNBUFFERED=1 \
    HF_HOME=/models/hf \
    PYTHONPATH=/opt/openeta

WORKDIR /opt/openeta

# The build context contains fixed snapshots named "unidepth" and "openeta".
# Keep the NGC image's validated Torch/CUDA stack; UniDepth's full requirements
# would otherwise replace Torch, Triton, and torchvision.
COPY unidepth /opt/unidepth
COPY openeta /opt/openeta

RUN python -m pip install --no-cache-dir \
        mcp==1.28.1 \
        uvicorn==0.51.0 \
        starlette==1.3.1 \
        opencv-python-headless==5.0.0.93 \
        timm==1.0.28 && \
    python -m pip install --no-cache-dir --no-deps -e /opt/unidepth

EXPOSE 8779

ENTRYPOINT ["python", "/opt/openeta/tools/unidepth_v2_mcp_server.py"]
CMD ["--transport", "sse", "--host", "0.0.0.0", "--port", "8779", \
     "--model-id", "lpiccinelli/unidepth-v2-vitl14", \
     "--device", "cuda", \
     "--resolution-level", "4"]
